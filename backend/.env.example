# Copy to backend/.env (gitignored). Everything works offline without these.
# Attacker A (cloud) — primary
ANTHROPIC_API_KEY=
# Attacker A — failover
GEMINI_API_KEY=
# Optional overrides
# TRACELESS_CLAUDE_MODEL=claude-opus-5-5
# TRACELESS_GEMINI_MODEL=gemini-2.5-flash
# TRACELESS_CLOUD_CALLS=3
# TRACELESS_OFFLINE=1          # force offline even if keys are set (Wi-Fi-off rehearsal)
# TRACELESS_DEVICE=cpu         # force CPU
# TRACELESS_HOST=192.168.1.20  # LAN IP to put in QR codes if auto-detect picks the wrong one
# TRACELESS_PORT=8000
